# Copy to .env and fill in from `terraform output` in infra/ — names match
# infra/outputs.tf 1:1 so wiring this up is copy-paste. PUBLIC_ prefix is SvelteKit's
# requirement for exposing a var to client code via $env/static/public.

# terraform output api_endpoint
PUBLIC_API_ENDPOINT=

# terraform output cognito_hosted_ui_domain
PUBLIC_COGNITO_HOSTED_UI_DOMAIN=

# terraform output cognito_client_id
PUBLIC_COGNITO_CLIENT_ID=
